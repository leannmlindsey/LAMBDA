# paths.env — single configuration file for the LAMBDA replication workflow.
#
# Copy this file to `paths.env` and fill in the values, then run the
# numbered scripts in this directory in order.
#
#   cp paths.env.template paths.env
#   vim paths.env
#   bash 01_download_zenodo.sh
#   bash 02_submit_inference_jobs.sh
#   python 03_build_website_data.py
#
# All paths must be absolute.

# ---------------------------------------------------------------------------
# Root directories
# ---------------------------------------------------------------------------

# Where 01_download_zenodo.sh will unpack the LAMBDA dataset.
# After download, this directory will contain:
#   binary_segments_{2k,4k,8k}/{train,dev,test}.csv     ← pre-built CSVs
#   error_and_bias_{2k,4k,8k}/test.csv                   ← pre-built CSVs
#   genome_wide_fastas/<assembly>.fna                    ← source FASTAs
#   ground_truth.csv                                     ← prophage locations
#   taxonomy.csv                                         ← per-assembly taxonomy
# The genome-wide segmented CSV subdirectories (genome_wide_segments_*) are
# auto-generated on first run of 02_submit_inference_jobs.sh from the FASTAs.
DATASET_ROOT="/path/to/LAMBDA_dataset"

# Where 01_download_zenodo.sh will unpack the fine-tuned model checkpoints.
# After download, this directory will contain one subfolder per model:
#   CHECKPOINTS_ROOT/dnabert2/{2k,4k,8k}/
#   CHECKPOINTS_ROOT/nucleotide_transformer_v2/{2k,4k,8k}/
#   ...
CHECKPOINTS_ROOT="/path/to/LAMBDA_checkpoints"

# Where 02_submit_inference_jobs.sh will write per-model prediction CSVs and
# SLURM logs. Layout produced:
#   RESULTS_ROOT/{model}/{category}/{window}/<inputfile>_predictions.csv
RESULTS_ROOT="/path/to/LAMBDA_results"

# ---------------------------------------------------------------------------
# Inference repo root (this clone of LAMBDA)
# ---------------------------------------------------------------------------
# Absolute path to the directory that contains `inference/`. Used by the
# submitter to locate each model's slurm_scripts/.
LAMBDA_REPO_ROOT="/path/to/LAMBDA"

# Directory of source FASTAs to use for the genome_wide category.
# Defaults to ${DATASET_ROOT}/genome_wide_fastas (what 01_download_zenodo.sh
# produces). For use case 3 (your own bacterial genomes), override this to
# point at your FASTA directory; step 02 will auto-segment them on first run.
FASTA_DIR=""    # leave blank to use ${DATASET_ROOT}/genome_wide_fastas

# ---------------------------------------------------------------------------
# Optional: metadata files for the website-data builder (step 03)
# ---------------------------------------------------------------------------
# Required: simple per-assembly taxonomy CSV. Two supported formats:
#   (a) Simple format (recommended):
#       assembly,phylum,class,order,family,genus,species
#       GCF_000007845.1,Pseudomonadota,Gammaproteobacteria,...
#   (b) GTDB-Tk format: the original gtdbtk.bac120.summary.tsv (used in the
#       paper). The script auto-detects which format you provided.
TAXONOMY_CSV="/path/to/taxonomy.csv"

# Optional: CheckV quality summary for ground-truth prophages
# (quality_summary.tsv from CheckV). Leave blank to skip.
CHECKV_TSV=""

# Optional: PHROG annotations CSV. Leave blank to skip. See step 04 for an
# optional workflow to generate this from your own predicted prophages.
PHROG_CSV=""

# ---------------------------------------------------------------------------
# Optional: per-model overrides
# ---------------------------------------------------------------------------
# Each per-model wrapper script in `inference/{model}/slurm_scripts/` accepts
# `--batch_size`, `--max_length`, and (where applicable) `--threshold`.
# You can override the defaults globally here. Leave blank to use each
# model's default.
BATCH_SIZE=""
THRESHOLD=""

# ---------------------------------------------------------------------------
# Models to run (space-separated). Comment out any you want to skip.
# ---------------------------------------------------------------------------
MODELS="dnabert2 nucleotide_transformer_v2 caduceus prokbert megadna generanno evo2_sae"

# ---------------------------------------------------------------------------
# Categories to run (space-separated).
#   binary       = binary_segments_{2k,4k,8k}
#   error_bias   = error_and_bias_{2k,4k,8k}
#   genome_wide  = genome_wide_segments_{2k_1k,4k_2k,8k_4k}
# ---------------------------------------------------------------------------
CATEGORIES="binary error_bias genome_wide"

# Window sizes to run for the binary and error_bias categories.
WINDOWS="2k 4k 8k"
